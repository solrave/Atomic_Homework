namespace: Game
className: GameEntityAPI
directory: Assets/Game/Scripts/Entities/Domain/API/
aggressiveInlining: true
unsafe: false
entityType: IGameEntity

imports:
- UnityEngine
- Atomic.Elements
- System.Collections.Generic
- Atomic.Entities
- Unity.Mathematics
- System.Numerics
- Game

tags:
    -Player
    -Moveable
    -Damageable
    -Alive

values:
# Animator
    -Animator : Animator
    
# Movement
    -MoveRequest : IRequest<Vector3>
    -MoveCondition : IExpression<Vector3, bool>
    -MoveAction : ICompositeAction<Vector3, float>
    -MoveEvent : IEvent<Vector3>
    
    -LookDirection : ReactiveVector3
    -MoveSpeed : IVariable<float>
    -RotationSpeed : IVariable<float>
    -Rigidbody : Rigidbody
    
# IsMoving
     -MoveDuration : Const<float>
     -MoveTime : IVariable<float>  
       
# Health
     -CurrentHealth : IReactiveVariable<float>
     -MaxHealth :  IValue<float>
     
# Death
     -HitCollider : Collider
     
# Damage
     -TakeDamageRequest : IRequest<float>
     -TakeDamageCondition : IExpression<float, bool>
     -TakeDamageAction : ICompositeAction<float>
     -TakeDamageEvent : IEvent<float>
     
     -Damage : IVariable<int>
     
# Attack
    -AttackRequest : IRequest<Vector3>
    -AttackCondition : IExpression<bool>
    -AttackAction : ICompositeAction<Vector3>
    -AttackEvent : IEvent
    
# Weapon
    -Weapon : IVariable<IGameEntity>
    -Ammo : IReactiveVariable<float>
    
# Bullet
    -LifeTime : DownTimer
    -Trigger : TriggerEvents
    -SphereCastRadius : Const<float>
    -LayerMask : Const<LayerMask>
    -DespawnEvent : IEvent
    
# Trigger
    -TriggerEnemies : List<GameEntity>

# Zombie
    -Target : IVariable<IGameEntity>
    -AttackDistance : Const<float>

#Item
    -PickupRequest : IRequest<IGameEntity>
    -PickupCondition : AndExpression<IGameEntity>
    -PickupAction : ICompositeAction<IGameEntity>
    -PickupEvent : IEvent<IGameEntity>
    
    -VFX : ParticleSystem
    -SFX : AudioSource
    
    -Amount : Const<int>
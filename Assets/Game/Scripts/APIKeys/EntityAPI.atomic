namespace: Game
className: AtomicAPIExtensions
directory: Assets/Game/Scripts/APIKeys/
aggressiveInlining: true
unsafe: false
entityType: IEntity

imports:
- UnityEngine
- Atomic.Elements

tags:
    -Moveable
    -Damageable
    -Alive

values:
# Animator
    -Animator : Animator
# Movement RCAE
    -MoveRequest : IRequest<Vector3>
    -MoveCondition : IExpression<Vector3, bool>
    -MoveAction : ICompositeAction<Vector3, float>
    -MoveEvent : IEvent<Vector3>
# Movement    
    -LookDirection : ReactiveVector3
    -MoveSpeed : IVariable<float>
    -RotationSpeed : IVariable<float>
    -Rigidbody : Rigidbody
# IsMoving
     -MoveDuration : Const<float>
     -MoveTime : IVariable<float>    
# Health
     -CurrentHealth : IReactiveVariable<int>
     -MaxHealth :  IValue<int>
# Death
     -DeathEvent : IEvent<IEntity>
# Damage
     -Damage : IVariable<int>
# Damage RCAE
     -TakeDamageRequest : IRequest<int>
     -TakeDamageCondition : IExpression<int, bool>
     -TakeDamageAction : ICompositeAction<int>
     -TakeDamageEvent : IEvent<int>
     
  # Add your values here
  # - health: float
  # - position: Vector3

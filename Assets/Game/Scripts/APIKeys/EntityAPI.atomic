namespace: Game
className: AtomicAPIExtensions
directory: Assets/Game/Scripts/APIKeys/
aggressiveInlining: true
unsafe: false
entityType: IEntity

imports:
- UnityEngine
- Atomic.Elements
- System.Collections.Generic
- Atomic.Entities
- Unity.Mathematics

tags:
    -Player
    -Moveable
    -Damageable
    -Alive

values:
# Animator
    -Animator : Animator
    
# Movement
    -MoveRequest : IRequest<Vector3>
    -MoveCondition : IExpression<Vector3, bool>
    -MoveAction : ICompositeAction<Vector3, float>
    -MoveEvent : IEvent<Vector3>
    
    -LookDirection : ReactiveVector3
    -MoveSpeed : IVariable<float>
    -RotationSpeed : IVariable<float>
    -Rigidbody : Rigidbody
    
# IsMoving
     -MoveDuration : Const<float>
     -MoveTime : IVariable<float>  
       
# Health
     -CurrentHealth : IReactiveVariable<int>
     -MaxHealth :  IValue<int>
     
# Death
     -HitCollider : Collider
     
# Damage
     -TakeDamageRequest : IRequest<int>
     -TakeDamageCondition : IExpression<int, bool>
     -TakeDamageAction : ICompositeAction<int>
     -TakeDamageEvent : IEvent<int>
     
     -Damage : IVariable<int>
     
# Attack
    -AttackRequest : IRequest
    -AttackCondition : IExpression<bool>
    -AttackAction : ICompositeAction
    -AttackEvent : IEvent
    
    -AttackCooldown : ICooldown

# Weapon
    -Weapon : IVariable<IEntity>
    -Ammo : IVariable<int>
    -SpreadAngle : Const<float>
    -HitDelay : DownTimer
    
# Bullet
    -LifeTime : DownTimer
    -Trigger : TriggerEvents
    -SphereCastRadius : Const<float>
    -LayerMask : Const<LayerMask>
    
# Trigger
    -TriggerEnemies : List<SceneEntity>
    
# Zombie
    -Target : IVariable<IEntity>
    -AttackDistance : Const<float>
    
#Item
    -PickupRequest : IRequest<IEntity>
    -PickupCondition : AndExpression<IEntity>
    -PickupAction : ICompositeAction<IEntity>
    -PickupEvent : IEvent<IEntity>
    
    -VFX : ParticleSystem
    -SFX : AudioSource
    
    -Amount : Const<int>